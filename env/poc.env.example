# Copy to env/poc.env (gitignored) and fill in. No secrets here; secrets are
# exported per session or created as cluster Secrets by hand.
# Placeholders are quoted so an unfilled file still sources cleanly.
TRUST_DOMAIN=gateway.internal
POC_NAMESPACE=mcp-gateway-demo
VERIFY_TENANT_URL="https://TENANT.verify.ibm.com"
ENTRA_TENANT_ID="ENTRA_TENANT_GUID"
ENTRA_CLIENT_ID="ENTRA_CLIENT_GUID"
VAULT_ADDR_INTERNAL=http://vault.vault.svc:8200
REGISTRY="REGISTRY_ROUTE_OR_QUAY_ORG"
# Path to the cluster kubeconfig for this POC (kept outside the repo)
KUBECONFIG="PATH_TO_KUBECONFIG"
# Path to the Vault Enterprise license file (kept outside the repo)
VAULT_LICENSE_FILE="PATH_TO_LICENSE_HCLIC"
# Must be the app registration's own "Expose an API" scope. A Graph-audience
# token carries a nonce claim that IBM Verify refuses at the exchange, and the
# failure surfaces there rather than at sign-in.
ENTRA_API_SCOPE="api://ENTRA_CLIENT_GUID/SCOPE_NAME openid profile offline_access"
